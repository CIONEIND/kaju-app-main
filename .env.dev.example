# Modelo do arquivo /srv/kaju-dev/.env da VPS de DESENVOLVIMENTO.
#
# Este arquivo NÃO é lido pela aplicação em lugar nenhum — é só um template.
# Copie o conteúdo para /srv/kaju-dev/.env na VPS e preencha os valores reais.
# Ver docs/deploy-dev.md.

NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# Identifica o ambiente. "dese" (qualquer valor diferente de prod/producao/
# production) faz o assunto dos e-mails sair prefixado com [DESE].
# Aqui é só documentação: o docker-compose.dev.yml já injeta APP_ENV=dese fixo.
APP_ENV=dese

# ---------------------------------------------------------------------------
# Postgres do ambiente de desenvolvimento
#
# POSTGRES_* criam o container (docker-compose.dev.yml).
# DATABASE_URL é o que a aplicação usa — o host é `postgres`, o nome do serviço
# na rede `kaju-dev`, e a porta é 5432 (a interna do container, não a 5433 que
# é publicada no loopback do host).
# ---------------------------------------------------------------------------
POSTGRES_USER=kaju
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=kaju_dev

DATABASE_URL="postgresql://kaju:troque-por-uma-senha-forte@postgres:5432/kaju_dev?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
#
# NEXTAUTH_URL precisa ser a URL pública do subdomínio de dev (com https), não
# 127.0.0.1 — é ela que monta o callback do Google.
# Gere o secret com: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL="https://dev.SEU-DOMINIO"
NEXTAUTH_SECRET="troque-por-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# RBAC — primeiro administrador (bootstrap)
#
# O seed de RBAC (`npm run db:seed:rbac`) cria os papéis "Administrador",
# "Legado" e "Novo usuário", migra as contas existentes para "Legado" e, se
# esta variável estiver definida, promove a "Administrador" os usuários cujos
# e-mails estejam listados aqui (login Google do app, separados por vírgula).
#
# O usuário precisa ter feito login pelo menos uma vez (para existir na tabela
# User). Rode `npm run db:seed:rbac` depois de definir esta variável.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL="voce@empresa.com"

# ---------------------------------------------------------------------------
# TopManager ERP (SQL Server)
#
# As duas instâncias apontam para a mesma máquina, alcançada pelo WireGuard do
# host. Use o IP do peer dentro da VPN (o que aparece em `sudo wg show`), nunca
# o IP da LAN da outra ponta.
#
# Ambos os blocos são OBRIGATÓRIOS: knex-top-manager-producao.ts lança erro no
# import se qualquer SQL_SERVER_PROD_* estiver vazio, e isso derruba o container.
#
# SQL_SERVER_PROD_INSTANCE_NAME é opcional e usa o SQL Server Browser (UDP 1434).
# Se preencher, a porta é ignorada — e o UDP também precisa passar pelo túnel.
# ---------------------------------------------------------------------------
SQL_SERVER_DEV_HOST=10.0.0.0
SQL_SERVER_DEV_USER=
SQL_SERVER_DEV_PASS=
SQL_SERVER_DEV_PORT=1433

SQL_SERVER_PROD_HOST=10.0.0.0
SQL_SERVER_PROD_USER=
SQL_SERVER_PROD_PASS=
SQL_SERVER_PROD_PORT=1433
SQL_SERVER_PROD_INSTANCE_NAME=

# ---------------------------------------------------------------------------
# Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Cione [dev] <noreply@arizona.solutions>"
