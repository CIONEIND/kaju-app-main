NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Ambiente da aplicação
#
# Qualquer valor diferente de prod/producao/production é tratado como ambiente
# de dese, e o assunto dos e-mails enviados sai prefixado com [DESE].
#
# Tecnicamente opcional: sem a variável vale o NODE_ENV, e o `npm run dev` local
# já cairia em dese. Deixe explícito mesmo assim — só a produção
# (NODE_ENV=production e sem APP_ENV) fica sem o prefixo.
# ---------------------------------------------------------------------------
APP_ENV=prod

# ---------------------------------------------------------------------------
# Postgres (app database)
#
# Defaults match the `postgres` service in docker-compose.yml.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaju?schema=public"

# Optional overrides read by docker-compose.yml.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=kaju
# POSTGRES_PORT=5432

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# ---------------------------------------------------------------------------
# RBAC — primeiro administrador (bootstrap)
#
# O seed de RBAC (`npm run db:seed:rbac`) cria os papéis "Administrador",
# "Legado" e "Novo usuário", migra as contas existentes para "Legado" e, se
# esta variável estiver definida, promove a "Administrador" os usuários cujos
# e-mails estejam listados aqui (login Google do app, separados por vírgula).
#
# O usuário precisa ter feito login pelo menos uma vez (para existir na tabela
# User). Rode `npm run db:seed:rbac` depois de definir esta variável.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL="voce@empresa.com"

# ---------------------------------------------------------------------------
# TopManager ERP — "DESE" instance
#
# Reachable through the VPN. The database name is hardcoded to "TopManager" in
# src/lib/top-manager/db/knex-top-manager-desenvolvimento.ts.
#
# The values below point at the optional local SQL Server container described in
# db/sqlserver/README-fixtures — replace them with the DESE server credentials
# if you connect over the VPN instead.
# ---------------------------------------------------------------------------
SQL_SERVER_DEV_HOST=localhost
SQL_SERVER_DEV_USER=sa
SQL_SERVER_DEV_PASS="Dev@Passw0rd"
SQL_SERVER_DEV_PORT=1433

# ---------------------------------------------------------------------------
# TopManager ERP — "PROD" instance
#
# The real ERP, reachable only through the VPN. Host/user/pass/port are required
# and knex-top-manager-producao.ts throws at import time if any is empty.
#
# SQL_SERVER_PROD_INSTANCE_NAME is OPTIONAL. Set it only where the server
# actually uses a named instance (production, behind the VPN): the name is
# resolved via the SQL Server Browser service and `port` is then ignored.
# Leave it empty locally so the connection uses plain host:port instead.
# ---------------------------------------------------------------------------
SQL_SERVER_PROD_HOST=localhost
SQL_SERVER_PROD_USER=sa
SQL_SERVER_PROD_PASS="Dev@Passw0rd"
SQL_SERVER_PROD_PORT=1433
SQL_SERVER_PROD_INSTANCE_NAME=

RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM="Cione <noreply@arizona.solutions>"
